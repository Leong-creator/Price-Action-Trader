{
  "stage": "M15.background_watchdog",
  "title": "M15 后台看护器",
  "inputs": {
    "m15_runtime_engine": "sdk",
    "m15_sdk_runtime_config": "config/examples/m15_longbridge_sdk_runtime.json",
    "m15_realtime_supervisor_config": "config/examples/m15_longbridge_realtime_session_supervisor.paper_orders_enabled.json",
    "m15_account_state_config": "config/examples/m15_longbridge_realtime_account_state.json",
    "m15_dashboard_config": "config/examples/m15_longbridge_dashboard.json",
    "readiness_config": "config/examples/m15_opening_trade_readiness.paper_orders_enabled.json",
    "monday_acceptance_config": "config/examples/m15_monday_refresh_acceptance.json"
  },
  "compatibility_notes": {
    "m12_47": "managed outside watchdog; local research non-blocking"
  },
  "outputs": {
    "output_dir": "reports/strategy_lab/m10_price_action_strategy_refresh/daily_observation/m15_background_watchdog"
  },
  "watchdog": {
    "check_interval_seconds": 60,
    "command_timeout_seconds": 30,
    "analytics_refresh_interval_seconds": 300,
    "analytics_failure_retry_seconds": 3600,
    "analytics_command_timeout_seconds": 90,
    "runtime_recovery_grace_seconds": 20
  },
  "hard_boundaries": {
    "paper_simulated_only": true,
    "live_execution": false,
    "real_money_actions": false,
    "manual_m12_37_once": false,
    "margin_financing": false
  }
}
