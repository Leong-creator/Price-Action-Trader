      "row_trading_date_fields": [],
      "row_test_id_fields": [],
      "group_priority": [
        "trading_date"
      ],
      "min_bytes": 10485760,
      "keep_active_file": false
    }
  ],
  "snapshot_rules": [
    {
      "name": "account_snapshots_keep_latest",
      "paths": [
        "reports/strategy_lab/m10_price_action_strategy_refresh/daily_observation/m15_longbridge_realtime_execution/m15_longbridge_realtime_account_state.json",
