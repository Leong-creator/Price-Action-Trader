        "test_epoch_id",
        "test_id"
      ],
      "group_priority": [
        "trading_date",
        "test_id"
      ],
      "min_bytes": 1048576,
      "keep_active_file": true
    },
    {
      "name": "m14_large_ledgers",
      "paths": [
        "reports/strategy_lab/m10_price_action_strategy_refresh/daily_observation/m14_strategy_challenge/m14_challenge_day_ledger.jsonl",
        "reports/strategy_lab/m10_price_action_strategy_refresh/daily_observation/m14_strategy_challenge/m14_challenge_day_correction_ledger.jsonl",
