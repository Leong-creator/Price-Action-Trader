        "reports/strategy_lab/m10_price_action_strategy_refresh/daily_observation/m14_strategy_challenge/m14_internal_paper_execution_ledger.jsonl"
      ],
      "archive_dir_name": "archive",
      "active_trading_dates": [],
      "active_test_ids": [
        "m15-sdk-formal-single-strategy-20260716",
        "m15-sdk-formal-short-strategy-20260716"
      ],
      "row_time_fields": [
        "generated_at",
        "decision_at"
      ],
      "row_trading_date_fields": [
        "trading_date"
      ],
      "row_test_id_fields": [
        "test_epoch_id",
        "test_id",
        "run_id"
      ],
      "group_priority": [
        "trading_date",
        "test_id"
      ],
      "min_bytes": 524288,
      "keep_active_file": true
    },
    {
      "name": "m15_background_watchdog_log",
      "paths": [
        "reports/strategy_lab/m10_price_action_strategy_refresh/daily_observation/m15_background_watchdog/m15_background_watchdog.log"
